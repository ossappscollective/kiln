# Copy to .env. Never commit .env.

# Postgres for hosted mode. Use a file path such as file:./.mrm-data/mrm.db for SQLite (desktop, single user).
# DATABASE_URL=postgres://mrm:mrm@localhost:5432/mrm

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts store credentials at rest. Losing it means re-entering every credential.
MRM_MASTER_KEY=

PORT=8787

# Folder for screenshots, videos and icons (local disk). S3-compatible storage comes later.
MRM_DATA_DIR=./.mrm-data

# Built web UI served by the API. Relative to the working directory.
MRM_WEB_DIST=apps/web/dist

# 'inline' runs the background job worker inside the server (default). 'off' disables it.
MRM_WORKER=inline

# How often, in minutes, the worker looks for plan reminders: a target date due within 24 hours or
# passed, and rollout steps whose planned time passed. They are events (event stream and webhooks),
# not email or push. Default 15; 0 turns them off; otherwise 5 to 10080. Only runs where the worker
# runs (MRM_WORKER=inline). See docs/deployment.md.
# MRM_REMINDER_INTERVAL_MINUTES=15

# Customer reviews (docs/api/reviews.md): how often every app's reviews are read from its store, in
# minutes. 0 (default) is off, otherwise 15 to 10080. Read-only: replies are never sent. Google Play
# returns only the last 7 days of reviews, so use 360 (6 hours) or less for Android apps, or reviews
# written while nothing was reading are missed (the app then shows a gap warning). Only runs where
# the worker runs (MRM_WORKER=inline). A read can also be started by hand in the Reviews tab.
# MRM_REVIEW_SYNC_INTERVAL_MINUTES=0
# Days a stored review (a customer's text and display name: personal data) is kept. Older ones are
# deleted, 1000 at most per run, at most once an hour. Default 365; 0 keeps them all (0 to 3650).
# MRM_REVIEW_RETENTION_DAYS=365
# Replying to customer reviews in the App Store and Google Play (docs/api/reviews.md, ADR 0007).
# A reply is PUBLIC and cannot be recalled by this tool. Off by default: every reply route answers
# 409 reply_disabled until this is true. Only owners and admins can send; members can draft. The
# store credential needs the right to reply (docs/credentials.md). 'true' or 'false'.
# MRM_REVIEW_REPLY_ENABLED=false

# Changing a LIVE rollout in the stores (docs/api/rollout.md, ADR 0008): the Google Play staged
# rollout share, halt, resume and complete; the App Store phased release pause, resume and release
# to all. It changes what users receive, and "complete" and "release to all" cannot be undone from
# here. Off by default: every rollout route answers 409 rollout_disabled until this is true. Only
# owners and admins can change a rollout (and an API token only when its actions name
# releases.rollout). The store credential needs the right to release. 'true' or 'false'.
# MRM_STORE_ROLLOUT_ENABLED=false

# Store listing reads (docs/api/listing.md): how often, in minutes, the listing of every app with a
# store credential is read (texts, categories, age rating, privacy choices URL, screenshot counts).
# 0 (default) is off, otherwise 30 to 10080. Read-only. One read of a large listing is 100 to 200
# store requests, so prefer hours over minutes. The app sync also reads the listing. Only runs where
# the worker runs (MRM_WORKER=inline). See docs/deployment.md.
# MRM_LISTING_INTERVAL_MINUTES=0

# Extra origins allowed to send state-changing requests, comma separated. Only needed when
# the UI is served from somewhere other than this server.
MRM_TRUSTED_ORIGINS=

# 'multi' (default) is the hosted server with accounts. 'single_user' is the desktop app: no login,
# listens on 127.0.0.1 only, accepts only localhost Host headers, and starts its one session from
# MRM_LAUNCH_SECRET. See docs/adr/0003-single-user-mode.md.
# MRM_MODE=multi

# single_user only. 32 random bytes as base64url or hex. Generate with: openssl rand -hex 32
# The desktop shell generates and passes this itself. Spent by the first visit to
# /api/auth/launch?secret=... Treat it like a password.
# MRM_LAUNCH_SECRET=

# single_user only. Extra Host values to accept, comma separated: localhost, 127.0.0.1 or [::1]
# with a port. For the Vite dev server: localhost:5173. Anything else is refused at startup.
# MRM_ALLOWED_HOSTS=

# multi only. Set to 1 when exactly one reverse proxy that you control sits in front of the server
# and sets X-Forwarded-For (it must overwrite or append to what the client sent). The login rate
# limit per client address then uses the last X-Forwarded-For entry. With 0 (default) it uses the
# socket address, and X-Forwarded-For is ignored. See docs/deployment.md.
# MRM_TRUST_PROXY=0

# How scans and listings read a repository. 'auto' (default): from a local git clone, and from the
# GitHub API for that request when the clone cannot be used (git missing, an unexpected git failure);
# the fall back is written to the audit log and the server log. 'clone': clone only, errors are
# shown. 'api': the GitHub REST API only, git is never run. Applying a change set always uses the
# API. Needs git 2.34 or newer on the server. See docs/adr/0005-local-clone-reads.md.
# MRM_READS=auto

# Where the clones live (created with mode 0700). Default: <MRM_DATA_DIR>/clones. A clone is a
# cache and can be deleted at any time.
# MRM_CLONE_DIR=

# Seconds a fetched branch tip is reused before the next read fetches again. A scan always fetches.
# MRM_CLONE_TTL_SECONDS=60

# Keeping the clone folder small. A removed clone is fetched again by the next read.
# Disk budget for MRM_CLONE_DIR (500m, 2g, 10GiB or bytes; 0 = no limit). Least recently used first.
# MRM_CLONE_MAX_BYTES=2g
# Remove clones not used for this many days (0 = never).
# MRM_CLONE_IDLE_DAYS=30
# Minutes between sweeps (0 = off, otherwise 5 to 10080).
# MRM_CLONE_SWEEP_INTERVAL_MINUTES=360

# The git program. Default: git from PATH.
# MRM_GIT_PATH=git

# Local clones: the folders on this machine that may hold git clones to read (docs/adr/0005,
# docs/deployment.md). OFF when unset: the web app then says so and nobody can attach a folder.
# Absolute paths only, separated by ':' (';' on Windows). Only the COMMITTED state is read. Needs
# git, so it does nothing with MRM_READS=api.
# MRM_LOCAL_REPO_ROOTS=/Volumes/dev

# Writing to a local clone (docs/adr/0005-local-clone-reads.md). OFF unless 'true'. When on, an
# admin or owner can apply a change set as a COMMIT ON A NEW BRANCH of the clone (never the
# checked out branch, never the working tree, hooks or config), and optionally push that branch
# to GitHub and open a pull request. Needs MRM_LOCAL_REPO_ROOTS.
# MRM_LOCAL_REPO_WRITE=false
# Author and committer of those commits. Optional: the name and email of the person who applied
# the change set are used for what is not set (or "Mobile Release Manager <noreply@localhost>").
# MRM_GIT_AUTHOR_NAME=Release Bot
# MRM_GIT_AUTHOR_EMAIL=release-bot@example.com

# Signing of those commits (docs/adr/0005-local-clone-reads.md, "Signing"; docs/deployment.md).
# 'off' (default) leaves the commits unsigned. 'ssh' or 'gpg' signs them with a key YOU name here:
# the clone's and the user's git config are never used. If signing fails nothing is committed.
# MRM_GIT_SIGN=off
# ssh: absolute path of a private key file (chmod 600, no passphrase), or of the .pub of a key an
# ssh-agent holds (the server's SSH_AUTH_SOCK is then passed on). gpg: a key id or fingerprint.
# MRM_GIT_SIGNING_KEY=/Users/you/.ssh/mrm_signing
# Optional: absolute path of ssh-keygen / gpg. Default: found in PATH once at start.
# MRM_GIT_SIGNING_PROGRAM=/usr/bin/ssh-keygen
# gpg only (required): the keyring folder.
# MRM_GIT_GNUPGHOME=/Users/you/.gnupg

# docker compose only. Address the app's port 8787 is published on. 127.0.0.1 (default) keeps it
# reachable from this machine only, for a reverse proxy on the same host. 0.0.0.0 publishes it on
# every interface over plain HTTP. See docs/deployment.md.
# MRM_BIND=127.0.0.1

# Outbound webhooks go to public https addresses only. Set to 1 to also allow loopback and private
# network addresses, and plain http to localhost (for development, or a receiver on your own
# network). Cloud metadata (link-local) addresses stay refused. Leave it off on a shared server.
# See docs/api/webhooks.md.
# MRM_WEBHOOKS_ALLOW_PRIVATE=0

# Review translation can use a LibreTranslate server whose address an admin enters in Settings. By
# default that address must be https to a public host. Set to true to also allow loopback and
# private-network addresses and http://localhost (a LibreTranslate on your own network). WARNING:
# then anyone who can change workspace settings can make this server send requests, carrying review
# text, to any host on its network. Cloud metadata addresses stay refused. See docs/deployment.md.
# MRM_TRANSLATE_ALLOW_PRIVATE_URLS=false
