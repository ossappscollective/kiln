{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiln",
  "version": "0.0.0",
  "identifier": "dev.example.kiln",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mrm-node"],
    "resources": {
      "binaries/server/": "server/"
    },
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
