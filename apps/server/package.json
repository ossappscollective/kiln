{
  "name": "@kiln/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "demo": "node --disable-warning=ExperimentalWarning src/demo/main.ts",
    "demo:reset": "node --disable-warning=ExperimentalWarning src/demo/main.ts --reset",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@kiln/connectors": "workspace:*",
    "@kiln/core": "workspace:*",
    "@kiln/db": "workspace:*",
    "@kiln/vault": "workspace:*",
    "hono": "^4.6.0",
    "zod": "^3.25.0"
  }
}
