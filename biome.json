{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/*.svelte", "!**/src-tauri/gen", "!docs/design/mockups"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noControlCharactersInRegex": "off",
        "noAssignInExpressions": "warn",
        "useIterableCallbackReturn": "warn"
      },
      "correctness": {
        "noVoidTypeReturn": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*-test-helpers.ts", "**/testing.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnsafeOptionalChaining": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noAssignInExpressions": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
