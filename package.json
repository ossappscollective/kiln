{
  "name": "kiln",
  "private": true,
  "version": "0.0.0",
  "description": "Self-hostable manager for iOS and Android app releases, store listings and ASO.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kiln/server --filter @kiln/web dev",
    "build": "pnpm --filter @kiln/web build",
    "demo": "pnpm build && pnpm --filter @kiln/server demo",
    "demo:reset": "pnpm build && pnpm --filter @kiln/server demo:reset",
    "tauri": "pnpm --filter @kiln/desktop tauri",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "lint": "biome check .",
    "format": "biome format --write .",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:fix": "node scripts/i18n.mjs fix",
    "i18n:scan": "node scripts/i18n.mjs scan",
    "screenshots": "node scripts/screenshots/capture.mjs",
    "site:build": "node site/build.mjs",
    "site:test": "node --test \"site/test/*.test.mjs\"",
    "email:preview": "node --disable-warning=ExperimentalWarning scripts/email-preview.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
